# My Academia Buddy — Supabase Environment Configuration
# Copy this file to .env and insert your real credentials from Supabase Dashboard > Project Settings > API

# Your Supabase Project URL (e.g. https://abcdefghijklm.supabase.co)
VITE_SUPABASE_URL=

# Your Supabase Anon Public API Key (Safe for frontend exposure, subject to Row Level Security)
# NEVER put service_role secret keys in this file!
VITE_SUPABASE_ANON_KEY=
